{
  "format": 2,
  "slug": "todo-collab",
  "name": "待办协作",
  "version": "1.1.0",
  "description": "团队共享待办看板：支持应用内权限分工、个人置顶隔离存储与版本化数据库迁移。",
  "entry": "index.html",
  "icon": "icon.svg",
  "window": { "width": 880, "height": 620 },
  "requires": { "platform": 1 },
  "access": {
    "permissions": [
      { "name": "task.write", "title": "编辑任务", "default": true },
      { "name": "board.manage", "title": "管理看板" }
    ],
    "default_grant": "none"
  },
  "platform": {
    "uses": ["identity", "notify", "ui"],
    "provides": {
      "settings": {
        "fields": [
          {
            "key": "default_priority",
            "type": "select",
            "title": "新建任务默认优先级",
            "options": ["low", "normal", "high"],
            "default": "normal"
          }
        ]
      }
    }
  },
  "backend": {
    "runtime": "wasm",
    "abi": 1,
    "module": "backend/app.wasm",
    "limits": { "timeout_ms": 5000, "memory_mb": 64 },
    "routes": [
      { "path": "/state", "methods": ["GET"], "visibility": "app" },
      { "path": "/boards", "methods": ["POST"], "visibility": "permission:board.manage" },
      { "path": "/boards/*", "methods": ["DELETE"], "visibility": "permission:board.manage" },
      { "path": "/tasks", "methods": ["POST"], "visibility": "permission:task.write" },
      { "path": "/tasks/*", "methods": ["PATCH", "DELETE"], "visibility": "permission:task.write" },
      { "path": "/remind/*", "methods": ["POST"], "visibility": "app", "rate_limit": "20/min" },
      { "path": "/me/pins/*", "methods": ["POST", "DELETE"], "visibility": "app" },
      { "path": "/me/filter", "methods": ["PUT"], "visibility": "app" }
    ],
    "storage": {
      "shared": true,
      "account": true,
      "database_mb": 64,
      "files_mb": 128
    }
  }
}
